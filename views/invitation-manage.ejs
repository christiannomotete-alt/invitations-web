<!doctype html>
<html lang="fr">
<head>
  <%- include("partials/head", { title: "Gestion invitation", description: "Gestion RSVP et partages WhatsApp" }) %>
</head>
<body>
  <div class="page-wrap">
    <%- include("partials/header", { currentUser }) %>
    <main class="content">
      <section class="hero-card">
        <% const invitationTypeMeta = eventTypes.find((t) => t.value === selectedEventType) || eventTypes[0]; %>
        <div>
          <h1>Gestion invitation: <%= invitation.couple_names %></h1>
          <p class="muted">Type: <strong><%= invitationTypeMeta.label %></strong></p>
          <p class="muted">Les invites recoivent uniquement leurs liens RSVP prives par WhatsApp.</p>
          <p class="tiny">ID unique: <code><%= invitation.id %></code></p>
        </div>
        <div class="actions-inline">
          <a class="ghost-btn" href="/tableau-de-bord/invitation/<%= invitation.id %>/apercu">Apercu</a>
          <a class="ghost-btn" href="/tableau-de-bord/invitation/<%= invitation.id %>/tables">Tables</a>
          <a class="ghost-btn" href="/tableau-de-bord/invitation/<%= invitation.id %>/scanner">Scanner QR</a>
          <a class="ghost-btn" href="/tableau-de-bord/invitation/<%= invitation.id %>/pdf">Telecharger PDF</a>
          <a class="ghost-btn" href="/tableau-de-bord/invitation/<%= invitation.id %>/export.csv">Exporter CSV</a>
          <form action="/tableau-de-bord/invitation/<%= invitation.id %>/dupliquer" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="ghost-btn" type="submit">Dupliquer</button>
          </form>
          <a class="ghost-btn" href="/tableau-de-bord">Retour dashboard</a>
        </div>
      </section>

      <% if (success) { %><p class="alert success"><%= success %></p><% } %>
      <% if (error) { %><p class="alert error"><%= error %></p><% } %>

      <section class="grid two">
        <article class="panel">
          <h3>Compteurs automatiques RSVP</h3>
          <div class="stats">
            <span>Total invites: <strong><%= stats.guest_count || 0 %></strong></span>
            <span>Presents: <strong><%= stats.yes_count || 0 %></strong></span>
            <span>En attente: <strong><%= stats.pending_count || 0 %></strong></span>
            <span>Absents: <strong><%= stats.no_count || 0 %></strong></span>
          </div>
        </article>
        <article class="panel">
          <h3>Edition rapide</h3>
          <form class="stack" action="/tableau-de-bord/invitation/<%= invitation.id %>/modifier?_csrf=<%= encodeURIComponent(csrfToken) %>" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Modele d'invitation
              <select name="templateKey" id="templateKey">
                <option value="">Personnalise</option>
                <% (invitationTemplates || []).forEach((template) => { %>
                  <option
                    value="<%= template.value %>"
                    data-event-type="<%= template.eventType %>"
                    data-message="<%= template.message %>"
                    <%= invitation.template_key === template.value ? "selected" : "" %>
                  ><%= template.label %></option>
                <% }) %>
              </select>
            </label>
            <label>Type d'invitation
              <select name="eventType" id="eventType" required>
                <% eventTypes.forEach((type) => { %>
                  <option value="<%= type.value %>" <%= selectedEventType === type.value ? "selected" : "" %>><%= type.label %></option>
                <% }) %>
              </select>
            </label>
            <label>Nom de l'evenement / organisateur
              <input name="coupleNames" type="text" required value="<%= invitation.couple_names %>">
            </label>
            <label>Date
              <input name="eventDate" type="text" required value="<%= invitation.event_date %>">
            </label>
            <label>Date ISO pour relances auto (J-7/J-3)
              <input name="eventDateIso" type="date" value="<%= invitation.event_date_iso || '' %>">
            </label>
            <label>Lieu
              <input name="venue" type="text" required value="<%= invitation.venue %>">
            </label>
            <label>Message
              <textarea name="message" id="message" rows="3" required><%= invitation.message %></textarea>
            </label>
            <section class="subpanel stack">
              <h3>Style visuel</h3>
              <div class="grid three compact-grid">
                <label>Couleur principale
                  <select name="themeAccent">
                    <% (themeAccents || []).forEach((accent) => { %>
                      <option value="<%= accent.value %>" <%= (invitation.theme_accent || "bleu") === accent.value ? "selected" : "" %>><%= accent.label %></option>
                    <% }) %>
                  </select>
                </label>
                <label>Typographie
                  <select name="themeFont">
                    <% (themeFonts || []).forEach((font) => { %>
                      <option value="<%= font.value %>" <%= (invitation.theme_font || "sans") === font.value ? "selected" : "" %>><%= font.label %></option>
                    <% }) %>
                  </select>
                </label>
                <label>Presentation
                  <select name="themeStyle">
                    <% (themeStyles || []).forEach((style) => { %>
                      <option value="<%= style.value %>" <%= (invitation.theme_style || "envelope") === style.value ? "selected" : "" %>><%= style.label %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
            </section>
            <div class="grid two compact-grid">
              <label>Capacite totale
                <input name="capacity" type="number" min="1" value="<%= invitation.capacity || '' %>">
              </label>
              <label>Telephone organisateur
                <input name="organizerPhone" type="tel" value="<%= invitation.organizer_phone || '' %>" placeholder="22890000000">
              </label>
            </div>
            <label>Programme / horaires
              <textarea name="schedule" rows="3"><%= invitation.schedule || '' %></textarea>
            </label>
            <div class="grid two compact-grid">
              <label>Dress code
                <input name="dressCode" type="text" value="<%= invitation.dress_code || '' %>">
              </label>
              <label>Lien carte / itineraire
                <input name="mapUrl" type="url" value="<%= invitation.map_url || '' %>">
              </label>
            </div>
            <label>Nouvelle image (optionnel)
              <input name="image" type="file" accept="image/png,image/jpeg,image/webp">
            </label>
            <label>OG title
              <input name="ogTitle" type="text" value="<%= invitation.og_title || '' %>">
            </label>
            <label>OG description
              <textarea name="ogDescription" rows="3"><%= invitation.og_description || '' %></textarea>
            </label>
            <label>Ajouter des invites (Nom|Numero ou Nom +Numero)
              <textarea name="newGuests" rows="5" placeholder="Nouvel Invite|22892000000&#10;Autre Invite +22893000000"></textarea>
            </label>
            <label>Coller un CSV invite (nom,numero)
              <textarea name="guestsCsv" rows="4" placeholder="nom,numero&#10;Marie,22890000000"></textarea>
            </label>
            <label>Importer un fichier CSV (export Excel en .csv)
              <input name="guestsCsvFile" type="file" accept=".csv,text/csv,text/plain,application/vnd.ms-excel">
            </label>
            <button class="primary-btn" type="submit">Enregistrer</button>
          </form>
        </article>
      </section>

      <section class="grid two">
        <article class="panel">
          <h3>Statistiques avancees</h3>
          <div class="stats">
            <span>Taux de reponse: <strong><%= advancedStats.responseRate %>%</strong></span>
            <span>Reponses recues: <strong><%= advancedStats.respondedCount %>/<%= advancedStats.guestCount %></strong></span>
            <span>Taux de presence: <strong><%= advancedStats.yesRateAmongResponses %>%</strong></span>
            <span>Personnes attendues: <strong><%= advancedStats.attendeeCount %><%= advancedStats.capacity ? `/${advancedStats.capacity}` : "" %></strong></span>
            <% if (advancedStats.capacity) { %>
              <span>Capacite utilisee: <strong><%= advancedStats.capacityRate %>%</strong></span>
            <% } %>
          </div>
        </article>
        <article class="panel">
          <h3>Top non-repondants</h3>
          <% if (!topPendingGuests.length) { %>
            <p class="muted">Tout le monde a repondu.</p>
          <% } else { %>
            <div class="stats">
              <% topPendingGuests.forEach((guest) => { %>
                <span><%= guest.full_name %><%= guest.phone ? ` (${guest.phone})` : "" %></span>
              <% }) %>
            </div>
          <% } %>
        </article>
      </section>

      <section class="panel">
        <h3>Courbe des reponses (30 derniers jours actifs)</h3>
        <% if (!trend.length) { %>
          <p class="muted">Aucune reponse enregistree pour le moment.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Jour</th>
                  <th>Oui</th>
                  <th>Non</th>
                  <th>Total jour</th>
                  <th>Cumul</th>
                </tr>
              </thead>
              <tbody>
                <% trend.forEach((entry) => { %>
                  <tr>
                    <td><%= entry.day %></td>
                    <td><%= entry.yesCount %></td>
                    <td><%= entry.noCount %></td>
                    <td><%= entry.total %></td>
                    <td><strong><%= entry.cumulative %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <% const confirmedGuests = guests.filter((g) => g.rsvp_status === "yes"); %>
      <section class="panel">
        <h3>Liste des confirmes</h3>
        <% if (!confirmedGuests.length) { %>
          <p class="muted">Aucune confirmation pour le moment.</p>
        <% } else { %>
          <p><strong><%= confirmedGuests.length %></strong> invite(s) ont confirme leur presence.</p>
          <div class="stats">
            <% confirmedGuests.forEach((guest) => { %>
              <span><%= guest.full_name %></span>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="panel">
        <h3>Relances WhatsApp</h3>
        <form class="actions-inline" action="/tableau-de-bord/invitation/<%= invitation.id %>/relancer" method="post" onsubmit="return confirm('Envoyer cette relance WhatsApp ?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="scope" aria-label="Invites a relancer">
            <option value="pending">Non-repondants</option>
            <option value="failed">Derniers echecs WhatsApp</option>
            <option value="all">Tous les invites</option>
          </select>
          <button class="primary-btn" type="submit">Envoyer la relance</button>
        </form>
      </section>

      <section class="panel stack">
        <h3>Import avec previsualisation</h3>
        <form class="stack" action="/tableau-de-bord/invitation/<%= invitation.id %>/import/preview" method="post" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Coller un CSV enrichi
            <textarea name="guestsCsv" rows="4" placeholder="nom,numero,table,place,categorie,accompagnants&#10;Marie,22890000000,Table 1,A1,Famille,1"></textarea>
          </label>
          <label>Importer CSV ou Excel (.xlsx)
            <input name="guestsCsvFile" type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
          </label>
          <button class="primary-btn" type="submit">Previsualiser l'import</button>
        </form>
      </section>

      <section class="panel">
        <h3>Liste des invites et partage WhatsApp</h3>
        <% if (!guests.length) { %>
          <p class="muted">Aucun invite pour le moment.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Numero</th>
                  <th>Statut</th>
                  <th>Placement</th>
                  <th>Details RSVP</th>
                  <th>WhatsApp</th>
                  <th>Controle</th>
                  <th>Lien unique</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% guests.forEach((guest) => { %>
                  <tr>
                    <td data-label="Nom"><%= guest.full_name %></td>
                    <td data-label="Numero"><%= guest.phone || '-' %></td>
                    <td data-label="Statut">
                      <% if (guest.rsvp_status === "yes") { %>Present<% } %>
                      <% if (guest.rsvp_status === "no") { %>Absent<% } %>
                      <% if (guest.rsvp_status === "pending") { %>En attente<% } %>
                    </td>
                    <td data-label="Placement" class="tiny">
                      <div>Categorie: <strong><%= guest.category || "-" %></strong></div>
                      <div>Table: <strong><%= guest.table_name || "-" %></strong></div>
                      <div>Place: <strong><%= guest.seat_label || "-" %></strong></div>
                    </td>
                    <td data-label="Details RSVP" class="tiny">
                      <% if (guest.rsvp_status === "yes") { %>
                        <div>Personnes: <strong><%= guest.attendee_count || 1 %></strong></div>
                        <div>+1: <strong><%= guest.plus_one ? "Oui" : "Non" %></strong></div>
                        <div>Menu: <strong><%= guest.menu_choice || "-" %></strong></div>
                        <div>Allergies: <strong><%= guest.allergies || "-" %></strong></div>
                        <div>Commentaire: <strong><%= guest.comment || "-" %></strong></div>
                      <% } else { %>
                        <span>-</span>
                      <% } %>
                    </td>
                    <td data-label="WhatsApp" class="tiny">
                      <div>Statut: <strong><%= guest.whatsapp_status || "not_sent" %></strong></div>
                      <div>Dernier envoi: <strong><%= guest.whatsapp_sent_at || "-" %></strong></div>
                      <div>Relance: <strong><%= guest.last_reminder_at || "-" %></strong></div>
                      <div><%= guest.whatsapp_detail || "-" %></div>
                    </td>
                    <td data-label="Controle" class="tiny">
                      <div>Check-in: <strong><%= guest.checked_in_at || "-" %></strong></div>
                      <a href="/tableau-de-bord/guest/<%= guest.id %>/qr.svg" target="_blank" rel="noopener">QR entree</a>
                    </td>
                    <td data-label="Lien unique"><a href="<%= guest.invitationUrl %>" target="_blank" rel="noopener">Lien RSVP</a></td>
                    <td data-label="Actions">
                      <div class="actions-inline">
                        <form class="stack" action="/tableau-de-bord/guest/<%= guest.id %>/modifier" method="post" style="min-width: 220px;">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input name="fullName" type="text" value="<%= guest.full_name %>" required>
                          <input name="phone" type="text" value="<%= guest.phone || '' %>" placeholder="22890000000">
                          <input name="category" type="text" value="<%= guest.category || '' %>" placeholder="Categorie">
                          <input name="tableName" type="text" value="<%= guest.table_name || '' %>" placeholder="Table">
                          <input name="seatLabel" type="text" value="<%= guest.seat_label || '' %>" placeholder="Place">
                          <input name="maxPlusOnes" type="number" min="0" max="9" value="<%= guest.max_plus_ones ?? 1 %>" aria-label="Accompagnants autorises">
                          <button class="ghost-btn" type="submit">Mettre a jour</button>
                        </form>
                        <a class="ghost-btn" href="<%= guest.whatsappLink %>" target="_blank" rel="noopener">WhatsApp</a>
                        <form action="/tableau-de-bord/guest/<%= guest.id %>/checkin" method="post">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="ghost-btn" type="submit">Check-in</button>
                        </form>
                        <form action="/tableau-de-bord/guest/<%= guest.id %>/supprimer" method="post">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="ghost-btn" type="submit">Supprimer</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
  <script>
    const templateSelect = document.getElementById("templateKey");
    const eventTypeSelect = document.getElementById("eventType");
    const messageField = document.getElementById("message");
    templateSelect?.addEventListener("change", () => {
      const option = templateSelect.selectedOptions[0];
      const eventType = option?.dataset.eventType || "";
      const message = option?.dataset.message || "";
      if (eventType) eventTypeSelect.value = eventType;
      if (message && !messageField.value.trim()) messageField.value = message;
    });
  </script>
  <script src="/js/theme.js"></script>
</body>
</html>
